# Template only. GitHub Actions will not run this file while it has the
# `.template` suffix. To enable it, copy or rename to:
#   .github/workflows/daily-arxiv.yml

name: Run arxiv-radar daily

on:
  workflow_dispatch:
  # Uncomment schedule after the first successful manual run.
  # schedule:
  #   - cron: "0 0 * * *"

env:
  GITHUB_USER_NAME: exopoiesis
  GITHUB_USER_EMAIL: lab@exopoiesis.space

jobs:
  update:
    name: update corpus and pages
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Run daily arxiv update
        run: python tools/daily_arxiv.py

      - name: Commit generated update
        uses: github-actions-x/commit@v2.9
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          commit-message: "GitHub Action automatic update: arxiv-radar-electrochemistry"
          files: README.md data/ abstracts/ docs/abstracts/ docs/_data/ docs/index.md docs/tag/
          rebase: "true"
          name: ${{ env.GITHUB_USER_NAME }}
          email: ${{ env.GITHUB_USER_EMAIL }}
